{
    "name": "jaws/sailing-club",
    "description": "JAWS - Social Day Cruising Program Management System",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "phpmailer/phpmailer": "^7.0",
        "eluceo/ical": "^2.13",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "robmorgan/phinx": "^0.16",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/phpunit",
        "quality:phpstan": "php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "quality:phpcs": "php vendor/bin/phpcs -n --standard=phpcs.xml",
        "quality": [
            "@quality:phpstan",
            "@quality:phpcs"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
