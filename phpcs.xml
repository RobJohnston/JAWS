<?xml version="1.0"?>
<ruleset name="JAWS">
    <description>PSR-12 coding standard for JAWS source and tests.</description>

    <rule ref="PSR12" />
    <rule ref="Generic.Files.LineEndings">
        <severity>0</severity>
    </rule>

    <arg name="extensions" value="php" />
    <arg name="parallel" value="4" />

    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <file>public/index.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/legacy/*</exclude-pattern>
</ruleset>
